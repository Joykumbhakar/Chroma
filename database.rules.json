{
  "rules": {
    "presence": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.isBoolean()"
      }
    },
    "users": {
      "$uid": {
        ".read": "auth != null",
        "online": {
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "newData.isBoolean()"
        },
        "lastSeen": {
          ".write": "auth != null && auth.uid === $uid"
        }
      }
    },
    "typing": {
      "$roomId": {
        ".read": "auth != null",
        "$uid": {
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "newData.isBoolean()"
        }
      }
    }
  }
}
