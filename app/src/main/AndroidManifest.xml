<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <!-- Android 13+ video access for Flash picker -->
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <!-- Android 13+ audio / music file access -->
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <!-- Android 14+ partial visual user selected permission -->
    <uses-permission android:name="android.permission.READ_MEDIA_VISUAL_USER_SELECTED" />
    <!-- Fallback for Android 12 and below -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <!-- Temp file writes for video trim/compress on older Android -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="28" />

    <application
        android:name=".ChromaApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="Oscellion"
        android:theme="@style/Theme.Oscellion"
        android:supportsRtl="true"
        android:enableOnBackInvokedCallback="true">

        <!-- Home Screen -->
        <activity
            android:name=".HomeActivity"
            android:exported="true"
            android:supportsPictureInPicture="true"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation"
            android:theme="@style/Theme.Oscellion.Splash"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Deep Link Intent Filters for Web Sharing (oscellion.vercel.app) -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="oscellion.vercel.app" />
            </intent-filter>

            <!-- Custom URI Schemes (oscellion:// and chromastudio://) -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="oscellion" />
            </intent-filter>

            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="chromastudio" />
            </intent-filter>

            <!-- Android System Share Sheet Target (Receive Files & Media) -->
            <intent-filter android:label="Oscellion">
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>
            <intent-filter android:label="Oscellion">
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="video/*" />
            </intent-filter>
            <intent-filter android:label="Oscellion">
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="audio/*" />
            </intent-filter>
            <intent-filter android:label="Oscellion">
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <intent-filter android:label="Oscellion">
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>

            <!-- Android System Share Sheet Target (Multiple Files / Media) -->
            <intent-filter android:label="Oscellion">
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>
            <intent-filter android:label="Oscellion">
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="video/*" />
            </intent-filter>
            <intent-filter android:label="Oscellion">
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
        </activity>

        <!-- Editor — opened by HomeActivity via Intent -->
        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:theme="@style/Theme.Oscellion"
            android:windowSoftInputMode="adjustResize" />
            
        <service
            android:name=".ChromaWallpaperService"
            android:label="Oscellion"
            android:permission="android.permission.BIND_WALLPAPER"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.wallpaper.WallpaperService" />
            </intent-filter>
            <meta-data
                android:name="android.service.wallpaper"
                android:resource="@xml/wallpaper" />
        </service>

        <service
            android:name=".services.ChromaMessagingService"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="chat_notifications_heads_up" />

        <receiver android:name=".ChatNotificationReceiver" android:exported="true">
            <intent-filter>
                <action android:name="com.chroma.studio.TEST_HEADS_UP" />
            </intent-filter>
        </receiver>

        <!-- Home Screen Widget: Studio Quick Actions (4x1 & 4x2) -->
        <receiver
            android:name=".widget.OscellionQuickActionsWidgetProvider"
            android:exported="true"
            android:label="Studio Quick Actions">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_studio_quick_actions_info" />
        </receiver>

        <!-- Home Screen Widget: Music & Sound Player (4x1 & 4x2) -->
        <receiver
            android:name=".widget.OscellionMusicWidgetProvider"
            android:exported="true"
            android:label="Studio Music Player">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.chroma.studio.WIDGET_MUSIC_PLAY_PAUSE" />
                <action android:name="com.chroma.studio.WIDGET_MUSIC_NEXT" />
                <action android:name="com.chroma.studio.WIDGET_MUSIC_PREV" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_music_player_info" />
        </receiver>

        <!-- Home Screen Widget: Quick Creative Capture (2x2) -->
        <receiver
            android:name=".widget.OscellionQuickCaptureWidgetProvider"
            android:exported="true"
            android:label="Quick Creative Capture">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_quick_capture_info" />
        </receiver>

        <!-- FileProvider for camera photo capture -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.provider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_provider_paths" />
        </provider>
    </application>

</manifest>
