<resources>
    <!-- Main editor theme -->
    <style name="Theme.Oscellion" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">#f8fafc</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <!-- Android 12 Splash Screen theme (used by HomeActivity) -->
    <style name="Theme.Oscellion.Splash" parent="Theme.SplashScreen">
        <!-- Cold-boot dark background matching Variation 3: Android Splash Screen (#0a0a0b) -->
        <item name="windowSplashScreenBackground">#0a0a0b</item>
        <!-- Animated icon (Apple Entry animation) -->
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_animated</item>
        <!-- Theme to apply once splash exits -->
        <item name="postSplashScreenTheme">@style/Theme.Oscellion</item>
    </style>


</resources>
