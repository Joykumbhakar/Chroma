<resources>
    <!-- Main editor theme -->
    <style name="Theme.Oscellion" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/oscellion_window_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <!-- Android 12 Splash Screen theme (used by HomeActivity) -->
    <style name="Theme.Oscellion.Splash" parent="Theme.SplashScreen">
        <!-- Cold-boot luxury light-black to dark-black gradient background -->
        <item name="android:windowBackground">@drawable/splash_bg_gradient</item>
        <item name="windowSplashScreenBackground">@drawable/splash_bg_gradient</item>
        <!-- Animated icon (Apple Entry animation) -->
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_animated</item>
        <!-- Theme to apply once splash exits -->
        <item name="postSplashScreenTheme">@style/Theme.Oscellion</item>
    </style>


</resources>
