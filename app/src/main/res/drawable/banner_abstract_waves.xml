<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="800dp"
    android:height="300dp"
    android:viewportWidth="800"
    android:viewportHeight="300">

    <!-- Deep Ocean Gradient Base -->
    <path
        android:pathData="M0,0 L800,0 L800,300 L0,300 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0"
                android:startY="0"
                android:endX="800"
                android:endY="300">
                <item android:color="#FF03071E" android:offset="0.0" />
                <item android:color="#FF0F3057" android:offset="0.5" />
                <item android:color="#FF00587A" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Flow Ribbon 1 -->
    <path
        android:pathData="M-50,150 C180,40 380,240 600,120 C720,60 780,160 850,140 L850,300 L-50,300 Z"
        android:alpha="0.4">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0"
                android:startY="100"
                android:endX="800"
                android:endY="300">
                <item android:color="#FF008891" android:offset="0.0" />
                <item android:color="#FF0F3057" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Flow Ribbon 2 -->
    <path
        android:pathData="M-50,210 C160,130 360,280 560,190 C680,140 760,250 850,230 L850,300 L-50,300 Z"
        android:alpha="0.5">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="800"
                android:startY="150"
                android:endX="0"
                android:endY="300">
                <item android:color="#FFE7E7DE" android:offset="0.0" />
                <item android:color="#FF008891" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Subtle Hairline Flow Curve -->
    <path
        android:pathData="M0,130 C200,30 400,230 600,110 C700,50 760,150 800,130"
        android:strokeWidth="1.5"
        android:strokeAlpha="0.4"
        android:strokeColor="#FFFFFFFF" />
</vector>
