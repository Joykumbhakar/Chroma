<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="800dp"
    android:height="300dp"
    android:viewportWidth="800"
    android:viewportHeight="300">

    <!-- Background Base Gradient -->
    <path
        android:pathData="M0,0 L800,0 L800,300 L0,300 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0"
                android:startY="0"
                android:endX="800"
                android:endY="300">
                <item android:color="#FF0040A8" android:offset="0.0" />
                <item android:color="#FF007AFF" android:offset="0.45" />
                <item android:color="#FF00B4D8" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Deep Wave 1 -->
    <path
        android:pathData="M0,80 C200,20 400,180 600,100 C700,60 760,120 800,110 L800,300 L0,300 Z"
        android:alpha="0.35">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0"
                android:startY="50"
                android:endX="800"
                android:endY="300">
                <item android:color="#FF002B7A" android:offset="0.0" />
                <item android:color="#FF0096C7" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Fluid Mesh Wave 2 -->
    <path
        android:pathData="M0,160 C150,90 350,230 550,140 C680,80 750,200 800,180 L800,300 L0,300 Z"
        android:alpha="0.45">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="800"
                android:startY="100"
                android:endX="0"
                android:endY="300">
                <item android:color="#FF48CAE4" android:offset="0.0" />
                <item android:color="#FF03045E" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Silk Wave 3 -->
    <path
        android:pathData="M0,220 C220,160 420,280 620,190 C720,150 770,240 800,220 L800,300 L0,300 Z"
        android:alpha="0.5">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0"
                android:startY="160"
                android:endX="800"
                android:endY="300">
                <item android:color="#FF90E0EF" android:offset="0.0" />
                <item android:color="#FF0077B6" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Ambient Glow Circles -->
    <path
        android:pathData="M250,90 A90,90 0 1,1 70,90 A90,90 0 1,1 250,90 Z"
        android:alpha="0.2">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="160"
                android:centerY="90"
                android:gradientRadius="90">
                <item android:color="#FFFFFFFF" android:offset="0.0" />
                <item android:color="#00FFFFFF" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <path
        android:pathData="M750,220 A120,120 0 1,1 510,220 A120,120 0 1,1 750,220 Z"
        android:alpha="0.25">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="630"
                android:centerY="220"
                android:gradientRadius="120">
                <item android:color="#FF00B4D8" android:offset="0.0" />
                <item android:color="#000077B6" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
