<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="800dp"
    android:height="300dp"
    android:viewportWidth="800"
    android:viewportHeight="300">

    <!-- Dark Carbon Background -->
    <path
        android:pathData="M0,0 L800,0 L800,300 L0,300 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0"
                android:startY="0"
                android:endX="800"
                android:endY="300">
                <item android:color="#FF0F172A" android:offset="0.0" />
                <item android:color="#FF1E293B" android:offset="0.5" />
                <item android:color="#FF090D16" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Titanium Sheen Angular Bevels -->
    <path
        android:pathData="M-50,0 L350,0 L150,300 L-250,300 Z"
        android:alpha="0.12">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0"
                android:startY="0"
                android:endX="300"
                android:endY="300">
                <item android:color="#FFFFFFFF" android:offset="0.0" />
                <item android:color="#00FFFFFF" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <path
        android:pathData="M250,0 L650,0 L450,300 L50,300 Z"
        android:alpha="0.08">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="250"
                android:startY="0"
                android:endX="550"
                android:endY="300">
                <item android:color="#FFFFFFFF" android:offset="0.0" />
                <item android:color="#00FFFFFF" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Cyan Micro-Luminescence Wave -->
    <path
        android:pathData="M0,200 C200,140 400,260 600,180 C700,140 760,210 800,200 L800,300 L0,300 Z"
        android:alpha="0.22">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0"
                android:startY="150"
                android:endX="800"
                android:endY="300">
                <item android:color="#FF38BDF8" android:offset="0.0" />
                <item android:color="#FF0284C7" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Tech Grid Lines -->
    <path
        android:pathData="M0,50 L800,50 M0,100 L800,100 M0,150 L800,150 M0,200 L800,200 M0,250 L800,250"
        android:strokeWidth="1"
        android:strokeColor="#10FFFFFF" />

    <path
        android:pathData="M100,0 L100,300 M200,0 L200,300 M300,0 L300,300 M400,0 L400,300 M500,0 L500,300 M600,0 L600,300 M700,0 L700,300"
        android:strokeWidth="1"
        android:strokeColor="#08FFFFFF" />
</vector>
