<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="800dp"
    android:height="300dp"
    android:viewportWidth="800"
    android:viewportHeight="300">

    <!-- Tech Dark Navy Base -->
    <path
        android:pathData="M0,0 L800,0 L800,300 L0,300 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0"
                android:startY="0"
                android:endX="800"
                android:endY="300">
                <item android:color="#FF0B132B" android:offset="0.0" />
                <item android:color="#FF1C2541" android:offset="0.5" />
                <item android:color="#FF3A506B" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Circuit Traces & Nodes -->
    <path
        android:pathData="M50,150 L200,150 L250,200 L450,200 L500,120 L750,120"
        android:strokeWidth="2"
        android:strokeAlpha="0.6"
        android:strokeColor="#FF5BC0BE" />

    <path
        android:pathData="M100,240 L300,240 L360,160 L600,160 L650,220 L780,220"
        android:strokeWidth="1.5"
        android:strokeAlpha="0.45"
        android:strokeColor="#FF6FFFE9" />

    <path
        android:pathData="M0,80 L180,80 L230,120 L400,120 L460,60 L700,60"
        android:strokeWidth="1.5"
        android:strokeAlpha="0.35"
        android:strokeColor="#FF5BC0BE" />

    <!-- Glow Nodes -->
    <path
        android:pathData="M200,150 A5,5 0 1,1 190,150 A5,5 0 1,1 200,150 Z"
        android:fillColor="#FF6FFFE9" />
    <path
        android:pathData="M500,120 A5,5 0 1,1 490,120 A5,5 0 1,1 500,120 Z"
        android:fillColor="#FF6FFFE9" />
    <path
        android:pathData="M360,160 A5,5 0 1,1 350,160 A5,5 0 1,1 360,160 Z"
        android:fillColor="#FF5BC0BE" />
    <path
        android:pathData="M650,220 A5,5 0 1,1 640,220 A5,5 0 1,1 650,220 Z"
        android:fillColor="#FF5BC0BE" />
</vector>
