rules_version = '2';

// ===============================================================
// Assumed Data Model
// ===============================================================
//
// 1. Collection: users
//    Document ID: {userId} (matches request.auth.uid)
//    Fields:
//      - uid: string (required, immutable) - Auth UID
//      - username: string (required) - Unique handle
//      - displayName: string (optional) - User profile name
//      - bio: string (optional) - User biography
//      - avatarUrl: string (optional) - Profile image URL
//      - publicKey: string (optional) - Public encryption key for E2EE chats
//      - followersCount: int (counter, updateable on follow)
//      - followingCount: int (counter, updateable on follow)
//      - isPrivateAccount: bool (privacy setting)
//      - verified: bool (server-managed verification badge; immutable by client)
//      - ... other profile & preference fields
//    Subcollections:
//      - /users/{userId}/followers/{followerId} (followerId is the follower's UID)
//      - /users/{userId}/following/{followingId} (followingId is the followed user's UID)
//      - /users/{userId}/follow_requests/{requesterId} (requesterId is the requesting user's UID)
//      - /users/{userId}/highlights/{highlightId} (saved permanent story highlights)
//      - /users/{userId}/liked_posts/{workId} (bookmarked/liked post record)
//      - /users/{userId}/saved_posts/{workId} (saved post record)
//      - /users/{userId}/shared_posts/{workId} (shared post record)
//      - /users/{userId}/notifications/{notifId} (in-app notifications for likes, follows, comments, messages)
//        Fields:
//          - id: string (notification ID)
//          - type: string (LIKE, COMMENT, MENTION, MESSAGE, FOLLOW, REMIX, SYSTEM)
//          - actorUid: string (UID of actor initiating event)
//          - actorName: string (display name of actor)
//          - actorHandle: string (username handle of actor)
//          - actorAvatarUrl: string (optional avatar URL)
//          - actorGender: string (optional)
//          - isVerified: bool
//          - actionText: string
//          - detailText: string (optional)
//          - targetPreviewUrl: string (optional preview image/thumbnail)
//          - timestamp: number (millisecond epoch timestamp)
//          - isRead: bool
//          - targetId: string (optional target document or room ID)
//
// 2. Collection: community_works
//    Document ID: {workId}
//    Fields:
//      - id: string (work ID)
//      - creatorId: string (immutable, creator's UID)
//      - authorUsername: string
//      - authorDisplayName: string
//      - authorAvatarUrl: string
//      - title: string
//      - description: string
//      - postType: string ("work" | "image")
//      - jsonUrl: string (compressed vector layers)
//      - imageUrl: string (Cloudinary CDN URL)
//      - likes / likesCount: int (interaction counter)
//      - likedBy: list of string
//      - remixCount: int (interaction counter)
//      - remixedBy: list of string
//      - downloadCount / downloadsCount: int (interaction counter)
//      - downloadedBy: list of string
//      - saveCount: int (interaction counter)
//      - savedBy: list of string
//      - shareCount: int (interaction counter)
//      - sharedBy: list of string
//      - commentCount / commentsCount: int (interaction counter)
//      - isArchived: bool
//    Subcollections:
//      - /community_works/{workId}/likes/{userId} (userId is the liker's UID)
//      - /community_works/{workId}/comments/{commentId} (comments subcollection)
//
// 3. Collection: usernames
//    Document ID: {username} (lowercase username string)
//    Fields:
//      - uid: string (owner UID)
//      - createdAt: number/timestamp
//
// 4. Collection: chats
//    Document ID: {chatId}
//    Fields:
//      - id: string
//      - name: string (optional group name)
//      - isGroup: bool
//      - avatarUrl: string (optional)
//      - participants: list of string (UIDs of participants)
//      - admins: list of string (UIDs of admins)
//      - createdBy: string (creator UID)
//      - groupDescription: string (optional)
//      - lastMessage: string
//      - lastSender: string
//      - lastMessageTime: number
//      - unreadCount: map of string -> int
//      - favoritedBy: list of string
//      - deletedBy: list of string
//      - deletedAt: map of string -> number
//    Subcollections:
//      - /chats/{chatId}/messages/{messageId}
//        Fields:
//          - id: string
//          - senderId: string (must match request.auth.uid)
//          - text: string
//          - timestamp: number
//          - isRead: bool
//          - messageType: string
//
// 5. Collection: flash_videos
//    Document ID: {flashId}
//    Fields:
//      - id: string
//      - creatorId: string (creator UID)
//      - videoUrl: string
//      - thumbnailUrl: string
//      - caption: string
//      - likes, likesCount, viewsCount, commentCount, commentsCount, remixCount, shareCount, saveCount: int
//      - dislikedBy, likedBy, viewedBy, remixedBy, sharedBy, savedBy: list of string
//      - isArchived: bool
//    Subcollections:
//      - /flash_videos/{flashId}/likes/{userId} (userId is the liker's UID)
//      - /flash_videos/{flashId}/comments/{commentId} (comments subcollection)
//
// 6. Collection: flash_comments
//    Document ID: {commentId}
//    Fields:
//      - id: string
//      - videoId: string
//      - userId: string (commenter UID)
//      - text: string
//      - timestamp: number
//      - likesCount: int
//      - likedBy: list of string
//      - dislikedBy: list of string
//      - isPinned / pinned: bool
//      - isCreatorHearted / creatorHearted: bool
//      - replyCount: int
//
// 7. Collection: stories
//    Document ID: {storyId}
//    Fields:
//      - id: string
//      - userId: string (creator UID)
//      - mediaUrl: string
//      - textContent: string
//      - expiresAt: number
//      - views, likes, shares, viewsCount, likesCount: int
//      - viewedBy, likedBy: list of string
//
// 8. Collection: user_chat_prefs
//    Document ID: {prefId} (e.g. {userId}_{roomId})
//    Fields:
//      - userId: string
//      - roomId: string
//      - muted: bool
//
// 9. Collection: reports
//    Document ID: {reportId}
//    Fields:
//      - reporterId: string (UID of reporting user)
//      - reportedUserId: string (optional)
//      - reportedUsername: string (optional)
//      - workId: string (optional)
//      - reason: string
//      - type: string (optional)
//      - timestamp: number
//
// 10. Collection: app_config
//     Document ID: {configId}
//     Fields:
//       - Global configuration settings and flags (managed exclusively via Firebase Admin SDK / backend)
//
// 11. Collection: calls
//     Document ID: {callId}
//     Fields:
//       - id: string (call session identifier)
//       - callerId: string (UID of call initiator)
//       - calleeId: string (UID of call recipient)
//       - type: string ("audio" | "video")
//       - status: string ("calling" | "ringing" | "accepted" | "rejected" | "ended" | "busy")
//       - offer: map / string (WebRTC SDP offer)
//       - answer: map / string (WebRTC SDP answer)
//       - timestamp: number / timestamp
//     Subcollections:
//       - /calls/{callId}/callerCandidates/{candId} (ICE candidates from caller)
//       - /calls/{callId}/calleeCandidates/{candId} (ICE candidates from callee)
// ===============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Helper Functions
    // ===============================================================
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function areImmutableFieldsUnchanged(fields) {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(fields);
    }

    function isValidCallDoc(data) {
      return (!('type' in data) || data.type in ['audio', 'video']) &&
             (!('status' in data) || data.status in ['calling', 'ringing', 'accepted', 'rejected', 'ended', 'busy']);
    }

    // ===============================================================
    // 1. Users Collection
    // ===============================================================
    match /users/{userId} {
      // Authenticated users can view public creator profiles
      allow read: if isAuthenticated();

      // Users can create (without self-verifying) and delete only their own profile
      allow create: if isOwner(userId) && (
        !('verified' in request.resource.data) ||
        request.resource.data.verified == false
      );
      allow delete: if isOwner(userId);

      // Owner can update their profile (cannot modify verified), OR any user can safely increment/decrement follower/following counts
      allow update: if isAuthenticated() && (
        (isOwner(userId) && areImmutableFieldsUnchanged(['verified'])) ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['followersCount', 'followingCount'])
      );

      // Subcollections
      match /followers/{followerId} {
        allow read: if isAuthenticated();
        allow write: if isAuthenticated() && (request.auth.uid == followerId || isOwner(userId));
      }

      match /following/{followingId} {
        allow read: if isAuthenticated();
        allow write: if isAuthenticated() && (isOwner(userId) || request.auth.uid == followingId);
      }

      match /follow_requests/{requesterId} {
        allow read: if isAuthenticated() && (isOwner(userId) || request.auth.uid == requesterId);
        allow create, update: if isAuthenticated() && request.auth.uid == requesterId;
        allow delete: if isAuthenticated() && (isOwner(userId) || request.auth.uid == requesterId);
      }

      match /highlights/{highlightId} {
        allow read: if isAuthenticated();
        allow write: if isOwner(userId);
      }

      match /liked_posts/{workId} {
        allow read, write: if isOwner(userId);
      }

      match /saved_posts/{workId} {
        allow read, write: if isOwner(userId);
      }

      match /shared_posts/{workId} {
        allow read, write: if isOwner(userId);
      }

      match /notifications/{notifId} {
        allow read, update: if isAuthenticated() && request.auth.uid == userId;
        allow delete: if isAuthenticated() && (request.auth.uid == userId || resource.data.actorUid == request.auth.uid);
        allow create: if isAuthenticated() && request.resource.data.actorUid == request.auth.uid;
      }
    }

    // ===============================================================
    // 2. Community Works Collection
    // ===============================================================
    match /community_works/{workId} {
      // Logged in users can view community works
      allow read: if isAuthenticated();

      // Only the author can create their work
      allow create: if isAuthenticated() && request.auth.uid == request.resource.data.creatorId;

      // Creator can edit their work, OR users can safely update interaction counters/tracking arrays
      allow update: if isAuthenticated() && (
        request.auth.uid == resource.data.creatorId ||
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['likes', 'likesCount', 'likedBy', 'remixCount', 'remixedBy', 'downloadCount', 'downloadedBy', 'downloadsCount', 'saveCount', 'savedBy', 'shareCount', 'sharedBy', 'commentCount', 'commentsCount'])
      );

      // Only creator can delete their work
      allow delete: if isAuthenticated() && (
        resource == null ||
        request.auth.uid == resource.data.creatorId ||
        (resource.data.userId != null && request.auth.uid == resource.data.userId)
      );

      // Subcollection for likes tracking
      match /likes/{userId} {
        allow read: if isAuthenticated();
        allow write: if isOwner(userId);
      }

      // Subcollection for comments
      match /comments/{commentId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated() && request.auth.uid == request.resource.data.userId;
        allow update: if isAuthenticated() && (
          request.auth.uid == resource.data.userId ||
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['likedBy', 'likesCount', 'dislikedBy', 'isPinned', 'pinned', 'isCreatorHearted', 'creatorHearted', 'replyCount'])
        );
        allow delete: if isAuthenticated() && (
          resource == null ||
          request.auth.uid == resource.data.userId ||
          request.auth.uid == get(/databases/$(database)/documents/community_works/$(workId)).data.creatorId
        );
      }
    }

    // ===============================================================
    // 3. Usernames Uniqueness Collection
    // ===============================================================
    match /usernames/{username} {
      allow read: if isAuthenticated();
      // Only the user owning this UID can claim or update their username mapping
      allow create: if isAuthenticated() && request.resource.data.uid == request.auth.uid;
      allow update: if isAuthenticated() && resource.data.uid == request.auth.uid && request.resource.data.uid == request.auth.uid;
      allow delete: if isAuthenticated() && resource.data.uid == request.auth.uid;
    }

    // ===============================================================
    // 4. Chat Rooms Collection
    // ===============================================================
    match /chats/{chatId} {
      // Split read into get and list so that collection queries (whereArrayContains) succeed.
      // - get: Allows single document read if the room doesn't exist yet (for client existence checks) OR if participant
      allow get: if isAuthenticated() && (resource == null || request.auth.uid in resource.data.participants);

      // - list: Allows collection queries where participants array contains the authenticated user UID
      allow list: if isAuthenticated() && request.auth.uid in resource.data.participants;

      // Creating a room: user must be in the participants array
      allow create: if isAuthenticated() && request.auth.uid in request.resource.data.participants;

      // Updating a room: user must be in the participants array (e.g. updating last message, unread counts)
      allow update: if isAuthenticated() && request.auth.uid in resource.data.participants;

      // Disallow complete room deletion from client
      allow delete: if false;

      // Subcollection: Messages
      match /messages/{messageId} {
        // Can only read messages if user is a participant of the parent chat room
        allow read: if isAuthenticated() &&
          request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;

        // Can create message if participant AND senderId matches their actual UID
        allow create: if isAuthenticated()
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants
          && request.resource.data.senderId == request.auth.uid;

        // Can update (e.g., mark as read, reactions) if participant
        allow update: if isAuthenticated() &&
          request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;

        // Users can only delete their own messages
        allow delete: if isAuthenticated()
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants
          && resource.data.senderId == request.auth.uid;
      }
    }

    // ===============================================================
    // 5. Flash Videos Collection
    // ===============================================================
    match /flash_videos/{flashId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.auth.uid == request.resource.data.creatorId;
      allow update: if isAuthenticated() && (
        request.auth.uid == resource.data.creatorId ||
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['dislikedBy', 'likes', 'likesCount', 'viewsCount', 'likedBy', 'viewedBy', 'commentCount', 'commentsCount', 'remixCount', 'remixedBy', 'shareCount', 'sharedBy', 'saveCount', 'savedBy'])
      );
      allow delete: if isAuthenticated() && (
        resource == null ||
        request.auth.uid == resource.data.creatorId ||
        (resource.data.userId != null && request.auth.uid == resource.data.userId)
      );

      // Subcollection for likes tracking
      match /likes/{userId} {
        allow read: if isAuthenticated();
        allow write: if isOwner(userId);
      }

      // Subcollection for comments
      match /comments/{commentId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated() && request.auth.uid == request.resource.data.userId;
        allow update: if isAuthenticated() && (
          request.auth.uid == resource.data.userId ||
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['likedBy', 'likesCount', 'dislikedBy', 'isPinned', 'pinned', 'isCreatorHearted', 'creatorHearted', 'replyCount'])
        );
        allow delete: if isAuthenticated() && (
          resource == null ||
          request.auth.uid == resource.data.userId ||
          request.auth.uid == get(/databases/$(database)/documents/flash_videos/$(flashId)).data.creatorId
        );
      }
    }

    // ===============================================================
    // 6. Flash Comments Collection
    // ===============================================================
    match /flash_comments/{commentId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.auth.uid == request.resource.data.userId;
      allow update: if isAuthenticated() && (
        request.auth.uid == resource.data.userId ||
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['likedBy', 'likesCount', 'dislikedBy', 'isPinned', 'pinned', 'isCreatorHearted', 'creatorHearted', 'replyCount'])
      );
      allow delete: if isAuthenticated() && (
        resource == null ||
        request.auth.uid == resource.data.userId ||
        (
          'videoId' in resource.data && resource.data.videoId != null && (
            (exists(/databases/$(database)/documents/flash_videos/$(resource.data.videoId)) &&
             request.auth.uid == get(/databases/$(database)/documents/flash_videos/$(resource.data.videoId)).data.creatorId) ||
            (exists(/databases/$(database)/documents/community_works/$(resource.data.videoId)) &&
             request.auth.uid == get(/databases/$(database)/documents/community_works/$(resource.data.videoId)).data.creatorId)
          )
        )
      );
    }

    // ===============================================================
    // 7. Stories Collection (24-hour disappearing stories)
    // ===============================================================
    match /stories/{storyId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.auth.uid == request.resource.data.userId;
      allow update: if isAuthenticated() && (
        request.auth.uid == resource.data.userId ||
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['viewedBy', 'likedBy', 'views', 'likes', 'shares', 'viewsCount', 'likesCount'])
      );
      allow delete: if isAuthenticated() && request.auth.uid == resource.data.userId;
    }

    // ===============================================================
    // 8. User Chat Preferences Collection
    // ===============================================================
    match /user_chat_prefs/{prefId} {
      // Split read into get and list so both single-doc checks on not-yet-created prefs
      // and collection queries (whereEqualTo("userId", currentUserId)) succeed.
      allow get: if isAuthenticated() && (resource == null || resource.data.userId == request.auth.uid);
      allow list: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid && request.resource.data.userId == request.auth.uid;
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // ===============================================================
    // 9. Reports Collection
    // ===============================================================
    match /reports/{reportId} {
      allow read: if false;
      allow create: if isAuthenticated() && request.resource.data.reporterId == request.auth.uid;
      allow update, delete: if false;
    }

    // ===============================================================
    // 10. App Config Collection (Read-only configuration for clients)
    // ===============================================================
    match /app_config/{configId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    // ===============================================================
    // 11. WebRTC Calls Collection
    // ===============================================================
    match /calls/{callId} {
      // Authenticated caller or callee can read call metadata and signaling status
      allow read: if isAuthenticated() && (
        request.auth.uid == resource.data.callerId ||
        request.auth.uid == resource.data.calleeId
      );

      // Caller initiates the call session
      allow create: if isAuthenticated() &&
        request.auth.uid == request.resource.data.callerId &&
        isValidCallDoc(request.resource.data);

      // Either participant can update (accept, reject, end, answer SDP), protecting participant IDs
      allow update: if isAuthenticated() && (
        request.auth.uid == resource.data.callerId ||
        request.auth.uid == resource.data.calleeId
      ) && areImmutableFieldsUnchanged(['callerId', 'calleeId'])
        && isValidCallDoc(request.resource.data);

      // Either participant can clean up / delete the call document
      allow delete: if isAuthenticated() && (
        request.auth.uid == resource.data.callerId ||
        request.auth.uid == resource.data.calleeId
      );

      // Subcollections for ICE candidates exchange
      match /callerCandidates/{candId} {
        allow read, write: if isAuthenticated() && (
          request.auth.uid == get(/databases/$(database)/documents/calls/$(callId)).data.callerId ||
          request.auth.uid == get(/databases/$(database)/documents/calls/$(callId)).data.calleeId
        );
      }

      match /calleeCandidates/{candId} {
        allow read, write: if isAuthenticated() && (
          request.auth.uid == get(/databases/$(database)/documents/calls/$(callId)).data.callerId ||
          request.auth.uid == get(/databases/$(database)/documents/calls/$(callId)).data.calleeId
        );
      }
    }
  }
}
