rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
  
    // 1. App-specific Users Collection
    match /users/{userId} {
      // Users can read any profile (so they can see other creators)
      allow read: if request.auth != null;
      
      // Allow users to update their own profile OR allow anyone to increment follower/following counts
      allow update: if request.auth != null && (
        request.auth.uid == userId ||
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['followersCount'])) ||
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['followingCount']))
      );
      
      allow create: if request.auth != null && request.auth.uid == userId;
      allow delete: if request.auth != null && request.auth.uid == userId;
      
      // Subcollections for following and followers
      match /followers/{followerId} {
        allow read: if request.auth != null;
        allow write: if request.auth != null && request.auth.uid == followerId;
      }
      
      match /following/{followingId} {
        allow read: if request.auth != null;
        allow write: if request.auth != null && request.auth.uid == userId;
      }
    }
    
    // 2. App-specific Community Works Collection
    match /community_works/{workId} {
      // Anyone logged in can read the works
      allow read: if request.auth != null;
      
      // Only the creator can upload their works
      allow create: if request.auth != null && request.auth.uid == request.resource.data.creatorId;
      
      // Only the creator can edit their works, OR anyone can safely update the interaction counts
      allow update: if request.auth != null && (
        request.auth.uid == resource.data.creatorId ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likesCount', 'downloadsCount', 'remixCount'])
      );
      
      // Only the creator can delete their works
      allow delete: if request.auth != null && request.auth.uid == resource.data.creatorId;
      
      // Subcollection for likes (Users can only add/remove their own like)
      match /likes/{userId} {
        allow read: if request.auth != null;
        allow write: if request.auth != null && request.auth.uid == userId;
      }
    }
    
    // 3. Usernames uniqueness collection
    match /usernames/{username} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
    
    // 4. Chat Rooms Collection (Firebase metadata)
    match /chats/{chatId} {
      // Only participants can read the room (or allow read if the room doesn't exist yet so we can check it)
      allow read: if request.auth != null && (resource == null || request.auth.uid in resource.data.participants);
      
      // Creating a room: user must be in the participants array
      allow create: if request.auth != null && request.auth.uid in request.resource.data.participants;
      
      // Updating a room: user must be in the participants array (e.g. updating last message)
      allow update: if request.auth != null && request.auth.uid in resource.data.participants;
      
      allow delete: if false; // Users shouldn't delete rooms completely, they just leave

      // Subcollection: Messages
      match /messages/{messageId} {
        // Can only read messages if user is a participant of the parent room
        allow read: if request.auth != null && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
        
        // Can create message if participant AND senderId matches their actual UID
        allow create: if request.auth != null 
                      && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants 
                      && request.resource.data.senderId == request.auth.uid;
        
        // Can update (e.g., mark as read) if participant
        allow update: if request.auth != null && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
        
        // Users can only delete their own messages
        allow delete: if request.auth != null 
                      && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants 
                      && resource.data.senderId == request.auth.uid;
      }
    }

    // 5. Flash Videos Collection
    match /flash_videos/{flashId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.creatorId;
      allow update: if request.auth != null && (
        request.auth.uid == resource.data.creatorId ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likesCount', 'viewsCount', 'likedBy', 'viewedBy'])
      );
      allow delete: if request.auth != null && request.auth.uid == resource.data.creatorId;
    }

    // 6. Stories Collection (24-hour disappearing stories)
    match /stories/{storyId} {
      // Any logged-in user can read stories (to see others' stories)
      allow read: if request.auth != null;

      // Only the story owner can create their own story
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;

      // Owner can fully update; anyone can update only viewedBy, likedBy, views, and likes
      allow update: if request.auth != null && (
        request.auth.uid == resource.data.userId ||
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['viewedBy', 'likedBy', 'viewsCount', 'likesCount'])
      );

      // Only the story owner can delete
      allow delete: if request.auth != null && request.auth.uid == resource.data.userId;
    }
  }
}
